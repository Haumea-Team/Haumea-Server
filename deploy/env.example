# haumea-server settings: copy to .env next to the server (or pass --env FILE).
# Every option is also HAUMEA_SERVER_<NAME>; the command line overrides these.

# Accounts, invites, roles and rooms live here (rooms in STATE_DIR/rooms).
HAUMEA_SERVER_STATE_DIR=/var/lib/haumea-session
HAUMEA_SERVER_PORT=7790
#HAUMEA_SERVER_BIND=
HAUMEA_SERVER_NAME=Crew
#HAUMEA_SERVER_MAX_CLIENTS=32

# Keep the map as Pawn whenever someone saves it, and autosave it every N minutes it changed.
HAUMEA_SERVER_MAPS_DIR=/var/lib/haumea-session/maps
HAUMEA_SERVER_AUTOSAVE=10
# Write one room's map straight into your game server's gamemodes folder.
#HAUMEA_SERVER_MAP_OUT=/home/samp/server/gamemodes/map.pwn
#HAUMEA_SERVER_MAP_OUT_ROOM=main

# Logging, as open.mp's: STATE_DIR/log.txt by default.
#HAUMEA_SERVER_LOG_FILE=/var/lib/haumea-session/log.txt
HAUMEA_SERVER_LOG_CHAT=1
HAUMEA_SERVER_LOG_CONNECTIONS=1
#HAUMEA_SERVER_TIMESTAMP_FORMAT=[%Y-%m-%dT%H:%M:%S%z]
